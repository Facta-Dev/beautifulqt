  "cards": [
    {
      "dot": "cyan",
      "title": "The password never enters the app",
      "items": [
        "the app opens the system browser with a PKCE verifier and a state value, and receives a loopback or custom-scheme redirect",
        "the authorization code plus the verifier go to the token endpoint; nothing is typed into the desktop app"
      ]
    },
    {
      "dot": "emerald",
      "title": "One secret store",
      "items": [
        "the access and refresh tokens are written through SecretStorePort — Windows Credential Manager, macOS Keychain, libsecret",
        "SQLite, config, logs, crash dumps and the binary hold no token; sign-out and tenant switch clear the keystore"
      ]
    },
    {
      "dot": "rose",
      "title": "Rotation and reuse detection",
      "items": [
        "each refresh rotates the token and replaces the stored copy — the old one is gone",
        "a reused refresh token revokes the whole family and the ViewModel shows a Forbidden status instead of silently succeeding"
      ]
    }
  ]
