  "cards": [
    {
      "dot": "cyan",
      "title": "The local store is a projection",
      "items": [
        "SQLite (WAL) through one storage adapter with a single connection/thread policy — the local rows are a cache, never the authority",
        "a server refresh replaces the projection; the server resolves a conflict and the rejected local change is shown, not hidden",
        "config files hold preferences and window state; like SQLite they hold no secret"
      ]
    },
    {
      "dot": "emerald",
      "title": "Secrets live elsewhere",
      "items": [
        "tokens go through SecretStorePort into the OS keystore — Windows Credential Manager, macOS Keychain, libsecret",
        "SQLite, config, logs, crash dumps and the binary hold no token; sign-out and tenant switch clear the keystore and the SQLite rows together"
      ]
    },
    {
      "dot": "rose",
      "title": "The outbox is durable local state",
      "items": [
        "a queued mutation is a row in the same SQLite database as the optimistic data — it survives a crash and a quit",
        "drains run on startup, on reconnect and on a timer, always off the GUI thread, each send carrying an idempotency key",
        "the retry ladder is bounded and ends in a dead-letter row for admins"
      ]
    }
  ]
}
